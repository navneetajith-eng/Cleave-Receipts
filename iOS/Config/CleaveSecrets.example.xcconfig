// Copy this file to CleaveSecrets.xcconfig. The real file is intentionally ignored.
// A Supabase publishable key is preferred; a legacy anon key is also supported.
// Never place a Supabase secret or service-role key in this client configuration.
CLEAVE_SUPABASE_ANON_KEY = your-supabase-publishable-or-anon-key
CLEAVE_API_BASE_URL = https:/$()/your-cloud-run-service-url/api/
DEVELOPMENT_TEAM = YOUR_TEAM_ID
